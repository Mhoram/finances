# Copy to .env and adjust.

# Port the API listens on.
PORT=3001

# Path to the SQLite DB file. Point this at your existing CGT-tracker
# database to migrate with zero transformation — the schema is identical:
#   DB_PATH=/path/to/CGT-tracker/data/cgt.db
DB_PATH=./data/cgt.db

# Comma-separated list of allowed origins for the frontend, e.g.:
#   CORS_ORIGIN=https://karlwallace.com,http://localhost:8080
# Leave unset to allow all origins (fine for local dev, not recommended once
# this is reachable outside your machine).
CORS_ORIGIN=

# Enable Banking API credentials (for cash flow / open banking sync)
# Get app_id from the Enable Banking control panel after registering your app.
ENABLE_BANKING_APP_ID=your-app-id-here

# Path to the private key PEM file downloaded during app registration.
# Keep this secret — never commit it.
ENABLE_BANKING_KEY_PATH=./keys/enablebanking.pem

# The HTTPS redirect URL registered with Enable Banking (must match exactly).
ENABLE_BANKING_REDIRECT_URL=https://finances.karlwallace.com/api/v1/bank-sync/callback
